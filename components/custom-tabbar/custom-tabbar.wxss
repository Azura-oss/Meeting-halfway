.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background-color: #FFFFFF;
  border-top: 2rpx solid var(--color-border, #E5E5E5);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tabbar-icon {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background-color: #E5E5E5;
}

.tabbar-text {
  font-size: 22rpx;
  color: #7A7A7A;
}

/* 选中态：微信绿 */
.tabbar-item-active .tabbar-icon {
  background-color: var(--color-primary, #07C160);
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.15);
}

.tabbar-item-active .tabbar-text {
  color: var(--color-primary, #07C160);
  font-weight: 700;
}
